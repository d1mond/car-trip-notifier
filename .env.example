# n8n - сгенерировать: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-32-char-random-string

# Traccar (уже запущен отдельно)
TRACCAR_URL=http://your-server-ip:8082
TRACCAR_DEVICE_ID=1
TRACCAR_USERNAME=admin@example.com
TRACCAR_PASSWORD=yourpassword

# Telegram Bot (создать через @BotFather)
# Chat ID - написать боту, потом открыть https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghIJKlmnoPQRstuvwXYZ
TELEGRAM_CHAT_ID=123456789

# Средний расход дизеля л/100км (используется если OBD не передаёт расход)
FUEL_L100KM=7.0
